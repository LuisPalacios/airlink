<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AirLink</RootNamespace>
    <AssemblyName>AirLink</AssemblyName>
    <ApplicationIcon>..\..\assets\app-connected-darktheme.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Version attributes are generated by SetGitVersion target in GitVersionInfo.cs -->
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\app-connected-darktheme.ico" LogicalName="AirLink.Icons.app-connected-darktheme.ico" />
    <EmbeddedResource Include="..\..\assets\app-connected-lighttheme.ico" LogicalName="AirLink.Icons.app-connected-lighttheme.ico" />
    <EmbeddedResource Include="..\..\assets\app-disconnected-darktheme.ico" LogicalName="AirLink.Icons.app-disconnected-darktheme.ico" />
    <EmbeddedResource Include="..\..\assets\app-disconnected-lighttheme.ico" LogicalName="AirLink.Icons.app-disconnected-lighttheme.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vanara.PInvoke.CoreAudio" Version="5.0.1" />
  </ItemGroup>

  <!-- Generate version from git describe: sets assembly metadata + GitVersionInfo.cs -->
  <Target Name="SetGitVersion" BeforeTargets="CoreCompile">
    <Exec Command="git describe --tags --long --always --dirty" ConsoleToMsBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDescribe" />
    </Exec>
    <PropertyGroup>
      <GitDescribe Condition="'$(GitDescribe)' == ''">dev</GitDescribe>
      <!-- Strip -0- from exact tag builds (v1.0.5-0-gabcdef → v1.0.5-gabcdef) -->
      <GitDescribe>$([System.Text.RegularExpressions.Regex]::Replace($(GitDescribe), '-0-(g[0-9a-f]+)', '-$1'))</GitDescribe>
      <!-- Full version string: append -dev for non-Release builds -->
      <GitVersion Condition="'$(Configuration)' == 'Release'">$(GitDescribe)</GitVersion>
      <GitVersion Condition="'$(Configuration)' != 'Release'">$(GitDescribe)-dev</GitVersion>
      <!-- Extract semver (e.g. 1.0.4 from v1.0.4-1-ge22025c) for assembly metadata -->
      <GitSemVer>$([System.Text.RegularExpressions.Regex]::Match($(GitDescribe), '(\d+\.\d+\.\d+)').Groups[1].Value)</GitSemVer>
      <GitSemVer Condition="'$(GitSemVer)' == ''">0.0.0</GitSemVer>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)GitVersionInfo.cs" Overwrite="true"
      Lines="using System.Reflection%3B&#10;[assembly: AssemblyVersion(&quot;$(GitSemVer).0&quot;)]&#10;[assembly: AssemblyFileVersion(&quot;$(GitSemVer).0&quot;)]&#10;[assembly: AssemblyInformationalVersion(&quot;$(GitVersion)&quot;)]&#10;namespace AirLink%3B&#10;internal static class GitVersionInfo { internal const string Version = &quot;$(GitVersion)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)GitVersionInfo.cs" />
    </ItemGroup>
  </Target>

</Project>
